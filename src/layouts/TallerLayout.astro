---
import '../styles/global.css';
import { site, taller } from '../config/site';
import Header from '../components/taller/Header.astro';
import AnnouncementBar from '../components/taller/AnnouncementBar.astro';
import Footer from '../components/taller/Footer.astro';
import BackToTop from '../components/taller/BackToTop.astro';
import ColorSchemeStyles from '../components/ColorSchemeStyles.astro';

interface Props {
  title?: string;
  description?: string;
}

const { title, description = site.description } = Astro.props;
const pageTitle = title ? `${site.title} - ${title}` : site.title;
---

<!doctype html>
<html lang={site.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" sizes="32x32" href={`${import.meta.env.BASE_URL}favicon-32x32.png`} />
    <link rel="icon" type="image/png" sizes="16x16" href={`${import.meta.env.BASE_URL}favicon-16x16.png`} />
    <link rel="apple-touch-icon" href={`${import.meta.env.BASE_URL}apple-touch-icon.png`} />
    {/* Precarga de las fuentes del primer render (Anton para títulos,
        Space Mono regular para todo el texto). Bold no: pesa igual pero
        sólo se usa en títulos chicos y llega a tiempo sin precarga. */}
    <link rel="preload" as="font" type="font/woff2" href={`${import.meta.env.BASE_URL}fonts/anton-regular.woff2`} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={`${import.meta.env.BASE_URL}fonts/space-mono-regular.woff2`} crossorigin />
    <ColorSchemeStyles />
  </head>
  <body style={`--page-background:${taller.theme.pageBackground}`}>
    <AnnouncementBar />
    <Header />

    <main>
      <slot />
    </main>

    <Footer />
    <BackToTop />
  </body>
</html>
