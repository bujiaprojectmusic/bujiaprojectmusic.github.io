---
import '../styles/global.css';
import '../styles/print.css';
import { site, baseTheme, fonts } from '../config/site';
import ColorSchemeStyles from '../components/ColorSchemeStyles.astro';

interface Props {
  title?: string;
  description?: string;
}

const { title, description = site.description } = Astro.props;
const pageTitle = title ? `${title} — ${site.title}` : site.title;
---

<!doctype html>
<html lang={site.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <ColorSchemeStyles />
    <style define:vars={{
      paper: baseTheme.background,
      ink: baseTheme.ink,
      accent: baseTheme.main,
      fontBody: fonts.body,
      fontHead: fonts.head,
    }}>
      :root {
        --paper: var(--paper);
        --ink: var(--ink);
        --accent: var(--accent);
        --font-body: var(--fontBody);
        --font-head: var(--fontHead);
      }
    </style>
  </head>
  <body>
    <header class="site-header">
      <div class="container site-header__in">
        <a href={`${import.meta.env.BASE_URL}fanzine`} class="site-header__logo">
          {site.title}
        </a>
        <nav>
          <a href={`${import.meta.env.BASE_URL}volumenes`}>Volúmenes</a>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer fz-no-print">
      <div class="container">
        <p>{site.title} — {site.tagline}</p>
      </div>
    </footer>

    <style>
      .site-header {
        border-bottom: var(--border-w) solid var(--ink);
        background: var(--paper);
      }
      .site-header__in {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding-top: 1.2rem;
        padding-bottom: 1.2rem;
      }
      .site-header__logo {
        font-family: var(--font-head);
        font-weight: 700;
        text-transform: uppercase;
        text-decoration: none;
        font-size: 1.1rem;
        letter-spacing: 0.02em;
      }
      .site-header nav a {
        text-decoration: none;
        font-family: var(--font-head);
        font-weight: 700;
        text-transform: uppercase;
        font-size: 0.9rem;
      }
      .site-footer {
        border-top: var(--border-w) solid var(--ink);
        margin-top: 4rem;
        padding: 2rem 0;
        font-size: 0.85rem;
        text-align: center;
      }
    </style>
  </body>
</html>
