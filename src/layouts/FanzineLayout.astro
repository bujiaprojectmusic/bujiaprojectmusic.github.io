---
// ─────────────────────────────────────────────────────────────────────────
// Layout del fanzine La Jirafa Eléctrica: inmersivo, sin la barra de
// anuncios ni el header grande del taller. Header mínimo (logo → /,
// "Volúmenes", y un hueco para el bloque de descarga de PDFs de #9),
// footer mínimo. Importa print.css y aplica el colorScheme del volumen.
// Lo usan /fanzine, /volumenes y /fanzine/<slug>. Sin JavaScript.
// La lectura es scroll vertical continuo. El atajo fijo "↑ Inicio"
// (y, en un volumen, "≡ Índice" vía el slot `jump`) salta por anclas;
// no hay pasar de página. La paginación vive sólo en @media print.
// ─────────────────────────────────────────────────────────────────────────
import '../styles/global.css';
import '../styles/print.css';
import { site, taller } from '../config/site';
import type { ColorSchemeName } from '../config/site';
import ColorSchemeStyles from '../components/ColorSchemeStyles.astro';
import OptimizedImage from '../components/OptimizedImage.astro';

interface Props {
  title?: string;
  description?: string;
  // Esquema de color del volumen (se aplica a toda la página).
  colorScheme?: ColorSchemeName;
}

const { title, description = site.description, colorScheme = 'xerox' } = Astro.props;
const pageTitle = title ? `${site.title} - ${title}` : `${site.title} - Fanzine`;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const withBase = (href: string) => (/^https?:\/\//.test(href) ? href : `${base}${href}`);
---

<!doctype html>
<html lang={site.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" sizes="32x32" href={`${import.meta.env.BASE_URL}favicon-32x32.png`} />
    <link rel="icon" type="image/png" sizes="16x16" href={`${import.meta.env.BASE_URL}favicon-16x16.png`} />
    <link rel="apple-touch-icon" href={`${import.meta.env.BASE_URL}apple-touch-icon.png`} />
    {/* Mismas precargas que el resto del sitio (ver #5). */}
    <link rel="preload" as="font" type="font/woff2" href={`${import.meta.env.BASE_URL}fonts/anton-regular.woff2`} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={`${import.meta.env.BASE_URL}fonts/space-mono-regular.woff2`} crossorigin />
    <ColorSchemeStyles />
  </head>
  <body id="inicio" data-layout="fanzine" class:list={['fz-body', `scheme-${colorScheme}`]}>
    <header class="fz-header fz-no-print">
      <a href={withBase('/')} class="fz-header__logo" aria-label={`${taller.logo.alt} — ir al sitio del taller`}>
        {taller.logo.image ? (
          <OptimizedImage
            src={taller.logo.image}
            alt={taller.logo.alt}
            widths={[140, 280, 420]}
            sizes="140px"
            width={140}
            print={false}
            context="logo en FanzineLayout"
          />
        ) : (
          <span>{taller.logo.text}</span>
        )}
      </a>
      <nav class="fz-header__nav" aria-label="Fanzine">
        <a href={withBase('/fanzine')}>Fanzine</a>
        <a href={withBase('/volumenes')}>Volúmenes</a>
      </nav>
      {/* Hueco para el bloque de descarga de PDFs (issue #9). Hoy vacío. */}
      <div class="fz-header__download">
        <slot name="download" />
      </div>
    </header>

    <main class="fz-main">
      <slot />
    </main>

    <footer class="fz-footer fz-no-print">
      <p>
        <strong>La Jirafa Eléctrica</strong> — el fanzine de {site.title}.
        <a href={withBase('/')}>Volver al taller</a>
      </p>
    </footer>

    <nav class="fz-jump fz-no-print" aria-label="Atajos del fanzine">
      <a href="#inicio">↑ Inicio</a>
      <slot name="jump" />
    </nav>
  </body>
</html>

<style is:global>
  /* Scroll suave para las anclas del índice y el atajo "↑ Inicio",
     sólo si la persona no pidió menos movimiento. */
  @media (prefers-reduced-motion: no-preference) {
    html:has(.fz-body) {
      scroll-behavior: smooth;
    }
  }
  .fz-body {
    margin: 0;
    background: var(--paper);
    color: var(--ink);
    font-family: var(--font-body);
  }
</style>

<style>
  .fz-header {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.6rem 1rem;
    border-bottom: var(--border-w) solid var(--ink);
    background: var(--paper);
  }
  .fz-header__logo {
    display: inline-flex;
    text-decoration: none;
    color: inherit;
    font-family: var(--font-head);
    font-weight: 700;
  }
  .fz-header__logo img {
    display: block;
    width: 140px;
    height: 45px;
    object-fit: contain;
  }
  .fz-header__nav {
    display: flex;
    gap: 0.9rem;
    margin-left: auto;
  }
  .fz-header__nav a {
    font-family: var(--font-head);
    font-weight: 700;
    text-transform: uppercase;
    font-size: 0.8rem;
    letter-spacing: 0.04em;
    text-decoration: none;
    color: inherit;
    border-bottom: 3px solid var(--accent);
  }
  .fz-header__download:empty {
    display: none;
  }
  .fz-main {
    min-height: 60vh;
  }
  .fz-footer {
    border-top: var(--border-w) solid var(--ink);
    padding: 1.5rem 1rem 4.5rem;
    text-align: center;
    font-size: 0.8rem;
  }
  .fz-jump {
    position: fixed;
    right: 14px;
    bottom: 16px;
    z-index: 20;
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.35rem;
    max-width: calc(100vw - 28px);
  }
  .fz-jump :global(a) {
    font-family: var(--font-head);
    font-weight: 700;
    font-size: 0.7rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--ink);
    background: var(--paper);
    border: 2px solid var(--ink);
    border-radius: 999px;
    padding: 0.45em 0.75em;
    line-height: 1.2;
    box-shadow: 2px 2px 0 var(--ink);
  }
  .fz-jump :global(a:hover),
  .fz-jump :global(a:focus-visible) {
    background: var(--accent);
  }
  .fz-footer p {
    margin: 0;
  }
  .fz-footer a {
    color: inherit;
    margin-left: 0.5rem;
  }
  @media (max-width: 480px) {
    .fz-header__logo img {
      width: 110px;
      height: 36px;
    }
    .fz-header__nav {
      gap: 0.6rem;
    }
  }
</style>
