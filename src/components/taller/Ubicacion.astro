---
// Bloque "Dónde estamos": dirección (liga a Google Maps por búsqueda de
// dirección), horario, WhatsApp y mapa incrustado. Todo sale de
// src/data/taller.ts. Se usa en /nosotros (y sirve para cualquier otra
// página de contacto/ubicación).
// Uso en MDX: <Ubicacion />   (o <Ubicacion mapa={false} /> sin el iframe)
import { direccionTexto, direccion, mapa, whatsapp, contacto } from '../../data/taller';
import Horario from './Horario.astro';

interface Props {
  mapa?: boolean;
  title?: string;
}
const { mapa: showMap = true, title = 'Dónde estamos' } = Astro.props;
---

<section class="ubicacion" aria-labelledby="ubicacion-title">
  <h2 id="ubicacion-title" class="ubicacion__title">{title}</h2>
  <div class="ubicacion__grid">
    <div class="ubicacion__datos">
      <p class="ubicacion__label">Dirección</p>
      <p class="ubicacion__dir">
        <a href={mapa.url} target="_blank" rel="noreferrer noopener">
          {direccion.calle}, {direccion.colonia}
          <br />
          {direccion.ciudad}, {direccion.estado}
        </a>
      </p>
      <p class="ubicacion__maplink">
        <a href={mapa.url} target="_blank" rel="noreferrer noopener">Abrir en Google Maps →</a>
      </p>

      <p class="ubicacion__label">Horario</p>
      <Horario class="ubicacion__horario" />

      <p class="ubicacion__label">WhatsApp</p>
      <p class="ubicacion__wa">
        <a href={whatsapp.url} target="_blank" rel="noreferrer noopener">{whatsapp.numeroTexto}</a>
        {' · '}
        <a href={`mailto:${contacto.email}`}>{contacto.email}</a>
      </p>
    </div>

    {showMap && (
      <div class="ubicacion__mapa">
        <iframe
          src={mapa.embedUrl}
          title={`Mapa: ${direccionTexto}`}
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          allowfullscreen
        />
      </div>
    )}
  </div>
</section>

<style>
  .ubicacion {
    margin: 2.5rem 0;
    border: var(--border-w) solid var(--ink);
    border-radius: var(--radius);
    background: #fff;
    padding: 1.5rem;
  }
  .ubicacion__title {
    margin: 0 0 1rem;
  }
  .ubicacion__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
    gap: 1.5rem;
    align-items: start;
  }
  .ubicacion__label {
    font-family: var(--font-head);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-size: 0.75rem;
    opacity: 0.7;
    margin: 1.2rem 0 0.3rem;
  }
  .ubicacion__label:first-child {
    margin-top: 0;
  }
  .ubicacion__dir,
  .ubicacion__wa,
  .ubicacion__maplink {
    margin: 0;
    text-align: left;
  }
  .ubicacion__dir {
    font-family: var(--font-head);
    font-weight: 700;
    font-size: 1.05rem;
    line-height: 1.4;
  }
  .ubicacion__dir a {
    text-decoration: none;
  }
  .ubicacion__maplink {
    font-size: 0.85rem;
    margin-top: 0.3rem;
  }
  .ubicacion__horario {
    font-size: 0.95rem;
    max-width: 24rem;
  }
  .ubicacion__mapa {
    aspect-ratio: 4 / 3;
    border: 3px solid var(--ink);
    overflow: hidden;
    background: rgba(127, 127, 127, 0.15);
  }
  .ubicacion__mapa iframe {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
  }
  @media (max-width: 720px) {
    .ubicacion {
      padding: 1.1rem;
    }
    .ubicacion__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
