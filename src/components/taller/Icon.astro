---
// Set mínimo de íconos usados en el header del taller. Todo en trazo
// (currentColor), sin librerías externas, para poder tintarlos con CSS.
interface Props {
  name:
    | 'facebook'
    | 'instagram'
    | 'whatsapp'
    | 'search'
    | 'user'
    | 'home'
    | 'share'
    | 'menu'
    | 'close'
    | 'calendar'
    | 'arrow-up';
  class?: string;
}

const { name, class: className } = Astro.props;
---

{
  name === 'facebook' && (
    <svg class={className} viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path
        d="M15 8.5h2V5.3c-.35-.05-1.55-.15-2.96-.15-2.93 0-4.94 1.79-4.94 5.08V13H6.4v3.6h3.7V23h3.72v-6.4h3.55l.56-3.6h-4.11v-2.4c0-1.04.29-1.75 1.78-1.75Z"
        fill="currentColor"
      />
    </svg>
  )
}
{
  name === 'instagram' && (
    <svg class={className} viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <rect x="3.5" y="3.5" width="17" height="17" rx="5" stroke="currentColor" stroke-width="1.8" />
      <circle cx="12" cy="12" r="4.2" stroke="currentColor" stroke-width="1.8" />
      <circle cx="17.1" cy="6.9" r="1.1" fill="currentColor" />
    </svg>
  )
}
{
  name === 'whatsapp' && (
    <svg class={className} viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path
        d="M12 3.5a8.5 8.5 0 0 0-7.34 12.77L3.5 20.5l4.36-1.13A8.5 8.5 0 1 0 12 3.5Z"
        stroke="currentColor"
        stroke-width="1.6"
      />
      <path
        d="M8.7 8.4c.2-.4.4-.4.6-.4h.45c.15 0 .35 0 .5.4.2.5.65 1.6.7 1.75.06.15.1.3 0 .5-.1.2-.15.3-.3.45-.15.15-.3.35-.45.45-.15.15-.3.3-.15.6.2.35.85 1.35 1.8 2.2 1.25 1.1 2.15 1.4 2.5 1.55.35.15.55.15.75-.1.2-.25.85-1 1.1-1.35.25-.3.5-.25.8-.15.35.15 2 .95 2.35 1.1.35.15.6.25.7.4.1.2.1 1.05-.25 1.85-.35.8-1.85 1.5-2.55 1.55-.7.1-1.3.15-4.4-1.2-3.7-1.55-6.05-5.35-6.25-5.6-.15-.25-1.35-1.8-1.35-3.45s.85-2.45 1.15-2.8Z"
        fill="currentColor"
      />
    </svg>
  )
}
{
  name === 'search' && (
    <svg class={className} viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <circle cx="11" cy="11" r="6.5" stroke="currentColor" stroke-width="1.8" />
      <line x1="16" y1="16" x2="20.5" y2="20.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
    </svg>
  )
}
{
  name === 'user' && (
    <svg class={className} viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <circle cx="12" cy="8.2" r="3.4" stroke="currentColor" stroke-width="1.8" />
      <path d="M4.8 19.5c1.2-3.2 3.9-5 7.2-5s6 1.8 7.2 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
    </svg>
  )
}
{
  name === 'home' && (
    <svg class={className} viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path
        d="M4.5 11 12 4.5 19.5 11"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
      <path
        d="M6.5 9.5V19h11V9.5"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
    </svg>
  )
}
{
  name === 'share' && (
    <svg class={className} viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <circle cx="18" cy="6" r="2.3" stroke="currentColor" stroke-width="1.6" />
      <circle cx="6" cy="12" r="2.3" stroke="currentColor" stroke-width="1.6" />
      <circle cx="18" cy="18" r="2.3" stroke="currentColor" stroke-width="1.6" />
      <line x1="8" y1="10.8" x2="16" y2="7.2" stroke="currentColor" stroke-width="1.6" />
      <line x1="8" y1="13.2" x2="16" y2="16.8" stroke="currentColor" stroke-width="1.6" />
    </svg>
  )
}
{
  name === 'menu' && (
    <svg class={className} viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <line x1="4" y1="7" x2="20" y2="7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
      <line x1="4" y1="12" x2="20" y2="12" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
      <line x1="4" y1="17" x2="20" y2="17" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
    </svg>
  )
}
{
  name === 'close' && (
    <svg class={className} viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <line x1="5" y1="5" x2="19" y2="19" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
      <line x1="19" y1="5" x2="5" y2="19" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
    </svg>
  )
}
{
  name === 'arrow-up' && (
    <svg class={className} viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <line x1="12" y1="19" x2="12" y2="5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
      <path
        d="M6 11 12 5l6 6"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
    </svg>
  )
}
{
  name === 'calendar' && (
    <svg class={className} viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <rect x="3.5" y="5" width="17" height="15" rx="2.5" stroke="currentColor" stroke-width="1.8" />
      <line x1="3.5" y1="9.5" x2="20.5" y2="9.5" stroke="currentColor" stroke-width="1.8" />
      <line x1="7.5" y1="3.2" x2="7.5" y2="6.8" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
      <line x1="16.5" y1="3.2" x2="16.5" y2="6.8" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
    </svg>
  )
}
