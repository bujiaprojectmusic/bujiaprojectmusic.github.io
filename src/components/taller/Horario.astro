---
// Horario del taller como lista legible (móvil y escritorio), un renglón
// por bloque, el domingo como "Cerrado". Los datos salen de
// src/data/taller.ts. Lo usan el footer y el bloque de ubicación.
import { horario } from '../../data/taller';

interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<dl class:list={['horario', className]}>
  {horario.map((b) => (
    <div class:list={['horario__row', { 'horario__row--cerrado': !b.abre }]}>
      <dt>{b.dias}</dt>
      <dd>{b.texto}</dd>
    </div>
  ))}
</dl>

<style>
  .horario {
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.2rem;
  }
  /* Dos columnas: días (puede partirse en dos líneas si no entra) y
     horario a la derecha, siempre en el mismo renglón. */
  .horario__row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    column-gap: 1rem;
    align-items: baseline;
  }
  .horario dt {
    font-weight: 700;
  }
  .horario dd {
    margin: 0;
    white-space: nowrap;
    text-align: right;
  }
  .horario__row--cerrado dd {
    opacity: 0.7;
    text-transform: uppercase;
    font-size: 0.85em;
    letter-spacing: 0.04em;
  }
</style>
