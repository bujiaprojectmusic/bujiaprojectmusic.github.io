---
// Sección "¿Qué es [taller]?" debajo del hero: imagen + texto + botón.
// Los bloques salen de src/content/about/*.md(x) — agregar/quitar/editar
// uno es agregar/borrar/editar un archivo ahí (podés escribir el cuerpo
// en Markdown normal, con negritas/links/etc), sin tocar este componente.
// Cada bloque se prende/apaga con su propio `enabled`; la sección entera
// se apaga con taller.about.enabled en site.ts.
import { getCollection } from 'astro:content';
import { taller } from '../../config/site';
import PunkButton from './PunkButton.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const withBase = (href: string) => (/^https?:\/\//.test(href) ? href : `${base}${href}`);

const rawEntries = taller.about.enabled ? await getCollection('about', ({ data }) => data.enabled) : [];
const sorted = rawEntries.sort((a, b) => a.data.order - b.data.order);
const entries = await Promise.all(
  sorted.map(async (entry) => ({ ...entry, Content: (await entry.render()).Content })),
);
---

{
  entries.map((entry) => {
    const bgVars = [
      `--about-bg-image:url(${withBase(entry.data.backgroundImage || entry.data.image)})`,
      entry.data.backgroundOverlayColor && `--about-bg-color:${entry.data.backgroundOverlayColor}`,
      entry.data.backgroundOverlayOpacity != null && `--about-bg-opacity:${entry.data.backgroundOverlayOpacity}%`,
      entry.data.backgroundOverlayColorMobile && `--about-bg-color-mobile:${entry.data.backgroundOverlayColorMobile}`,
      entry.data.backgroundOverlayOpacityMobile != null &&
        `--about-bg-opacity-mobile:${entry.data.backgroundOverlayOpacityMobile}%`,
    ]
      .filter(Boolean)
      .join(';');

    return (
      <section class={`about-section scheme-${entry.data.colorScheme ?? taller.about.colorScheme}`} style={bgVars}>
        <div class="about-section__bg" aria-hidden="true" />

        <div
          class:list={['container-wide', 'about-section__in', { 'about-section__in--reverse': entry.data.imagePosition === 'right' }]}
        >
          <div
            class="about-section__img"
            role="img"
            aria-label={entry.data.imageAlt || ''}
            style={`background-image:url(${withBase(entry.data.image)})`}
          />

          <div class="about-section__body">
            <h2 class="about-section__title">{entry.data.title}</h2>
            <div class="about-section__content">
              <entry.Content />
            </div>

            {entry.data.ctaLabel && entry.data.ctaHref && (
              <div class="about-section__cta">
                {entry.data.ctaEyebrow && <p class="about-section__eyebrow">{entry.data.ctaEyebrow}</p>}
                <PunkButton href={withBase(entry.data.ctaHref)} label={entry.data.ctaLabel} />
              </div>
            )}
          </div>
        </div>
      </section>
    );
  })
}

<style>
  .about-section {
    position: relative;
    background: var(--paper);
    color: var(--ink);
    padding: 3.5rem 0;
    overflow: hidden;
    /* Tinte sobre la imagen de fondo: color + porcentaje son variables
       independientes (no un solo rgba) para que se puedan pisar por
       separado desde el frontmatter de cada bloque (about/*.md). En
       desktop la imagen de fondo sólo se asoma alrededor del recuadro,
       así que por default lleva un tinte oscuro para no competir con
       él. En mobile ocupa toda la sección detrás del texto, así que por
       default no lleva tinte (0%, transparente) — subilo por entrada si
       una foto en particular no contrasta bien con las letras. */
    --about-bg-color: #000000;
    --about-bg-opacity: 55%;
    --about-bg-color-mobile: transparent;
    --about-bg-opacity-mobile: 0%;
  }
  .about-section__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    background-image: var(--about-bg-image);
    background-size: cover;
    background-position: center;
    pointer-events: none;
  }
  .about-section__bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background: color-mix(in srgb, var(--about-bg-color) var(--about-bg-opacity), transparent);
  }

  .about-section__in {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: 2.5rem;
    align-items: center;
  }
  .about-section__in--reverse {
    grid-template-columns: 1.1fr 1fr;
  }
  .about-section__in--reverse .about-section__img {
    order: 2;
  }
  .about-section__in--reverse .about-section__body {
    order: 1;
  }

  /* Recuadro tipo marco de cine/escenario para la imagen en desktop:
     borde grueso + sombra dura corrida en el color de acento, mismo
     lenguaje que las tarjetas de catálogo/journal. */
  .about-section__img {
    aspect-ratio: 4 / 5;
    background-color: rgba(127, 127, 127, 0.15);
    background-size: cover;
    background-position: center;
    border: var(--border-w) solid var(--ink);
    border-radius: var(--radius);
    box-shadow: 10px 10px 0 var(--accent);
  }

  .about-section__title {
    font-family: 'Anton', var(--font-head);
    font-weight: 400;
    text-transform: uppercase;
    line-height: 1.05;
    font-size: clamp(1.8rem, 4vw, 2.8rem);
    margin: 0 0 1.1rem;
  }
  .about-section__content {
    font-size: 1rem;
    line-height: 1.6;
  }
  .about-section__content :global(p) {
    margin: 0 0 1em;
  }
  .about-section__content :global(p:last-child) {
    margin-bottom: 0;
  }

  .about-section__cta {
    margin-top: 1.5rem;
  }
  .about-section__eyebrow {
    font-family: var(--font-head);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    font-size: 0.85rem;
    margin: 0 0 0.8rem;
  }

  @media (max-width: 820px) {
    /* En mobile no hay recuadro: la misma imagen pasa a ser el fondo a
       toda la sección, sin tinte por default (ver --about-bg-*-mobile
       arriba), y el texto flota encima. */
    .about-section {
      min-height: 70vh;
      display: flex;
      align-items: center;
    }
    .about-section__bg::after {
      background: color-mix(in srgb, var(--about-bg-color-mobile) var(--about-bg-opacity-mobile), transparent);
    }
    .about-section__in,
    .about-section__in--reverse {
      grid-template-columns: 1fr;
      width: 100%;
    }
    /* En mobile siempre imagen primero, sin importar imagePosition. */
    .about-section__in--reverse .about-section__img,
    .about-section__in--reverse .about-section__body {
      order: initial;
    }
    .about-section__img {
      display: none;
    }
  }
</style>
