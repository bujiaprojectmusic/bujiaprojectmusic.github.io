---
// Columna de lectura de un volumen. En pantalla es flujo normal (una
// sola columna, scroll del navegador): los <Pliego> de adentro no se
// agrupan en dobles páginas. Al imprimir, cada <Pliego> ya es su propia
// página y este contenedor sólo deja de limitar el ancho.
// Lo usa src/pages/fanzine/[slug].astro.
---

<div class="fz-volume">
  <slot />
</div>

<style>
  .fz-volume {
    display: block;
    max-width: 900px;
    margin: 0 auto;
    padding: 1.5rem 1.25rem 3rem;
  }
  @media (max-width: 767px) {
    .fz-volume {
      padding: 1rem 1rem 3rem;
    }
  }
  @media print {
    .fz-volume {
      display: block;
      max-width: none;
      padding: 0;
      margin: 0;
    }
  }
</style>
