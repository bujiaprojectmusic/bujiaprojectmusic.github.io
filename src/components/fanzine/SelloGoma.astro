---
// Sello de goma (issue #17 parte b, vol. 01): doble borde, rotado, con
// tinta irregular (máscara de puntos que "deja sin tinta" partes del
// sello) y texto libre: «APROBADO», «HECHO EN TEXCOCO». 0 JS, 0 imágenes.
// Uso: <SelloGoma texto="Hecho en Texcoco" />
//      <SelloGoma texto="Aprobado" color="ink" angulo={6} />
import geo from '../../../print/componentes.json';

interface Props {
  texto: string;
  angulo?: number;
  /** rojo (default) | azul | ink | accent (del esquema). */
  color?: 'rojo' | 'azul' | 'ink' | 'accent';
  class?: string;
}
const G = geo.sello_goma;
const { texto, angulo = G.giro_grados_default, color = 'rojo', class: clase } = Astro.props;
const tinta = color === 'ink' ? 'var(--ink)' : color === 'accent' ? 'var(--accent)' : G.colores[color];
---

<span class:list={['fz-sello', clase]} style={`--fz-angulo:${angulo}deg;--fz-tinta:${tinta}`} role="img" aria-label={`Sello: ${texto}`}>
  <span class="fz-sello__in" aria-hidden="true">{texto}</span>
</span>

<style>
  .fz-sello {
    display: inline-block;
    transform: rotate(var(--fz-angulo));
    color: var(--fz-tinta);
    border: 3px solid currentColor;
    outline: 1px solid currentColor;
    outline-offset: 3px;
    padding: 0.35em 0.9em;
    margin: 0.5em 0.6em;
    font-family: var(--font-head);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-size: 1rem;
    line-height: 1;
    /* Tinta irregular: la máscara perfora el sello con puntos. */
    -webkit-mask-image: radial-gradient(circle, transparent 0.8px, #000 1.1px);
    mask-image: radial-gradient(circle, transparent 0.8px, #000 1.1px);
    -webkit-mask-size: 5px 5px;
    mask-size: 5px 5px;
    opacity: 0.92;
  }
  .fz-sello__in {
    display: inline-block;
    transform: translateY(0.05em);
  }
</style>
