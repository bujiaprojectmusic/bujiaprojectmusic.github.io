---
// ─────────────────────────────────────────────────────────────────────────
// Unidad de página del IMPRESO (media carta, n = 1…16, el mismo número
// que va a usar Typst). En la web NO es una página: es un tramo del
// scroll continuo. Los componentes punk (Portada, Indice, piezas,
// Contraportada) se apilan en flujo normal, una columna, sin caja de
// media carta, sin número de página y sin doble página.
//
// Uso en MDX (igual que antes; el mapa de 16 lo exige el cuadernillo):
//   <Pliego n={3} tipo="normal" scheme="acido">...markdown/componentes...</Pliego>
//   <Pliego n={7} tipo="relleno" />        ← placeholder: sólo se ve al imprimir
//
// - Pantalla: flujo normal. `tipo="relleno"` (página en blanco del
//   cuadernillo) se colapsa: queda el ancla `#pagina-N` para el índice,
//   sin caja. El control "↑ Inicio / ≡ Índice" vive una sola vez en el
//   layout, no en cada pliego.
// - Print: cada pliego es una página (break-before), con número.
// ─────────────────────────────────────────────────────────────────────────
import type { ColorSchemeName } from '../../config/site';
import OptimizedImage from '../OptimizedImage.astro';
import type { ImageSource } from '../../utils/resolveImage';

export type PliegoTipo = 'portada' | 'indice' | 'normal' | 'relleno' | 'fin' | 'contraportada';

interface Props {
  /** Número de página del impreso, 1–16. También es el ancla #pagina-N. */
  n: number;
  scheme?: ColorSchemeName;
  /** Fondo a sangre: color (true) o imagen (ruta "/img/..." o import). En
      pantalla la imagen va en el flujo; al imprimir cubre la página. */
  bleed?: boolean | ImageSource;
  tipo?: PliegoTipo;
  /** Texto alternativo si `bleed` es una imagen. */
  bleedAlt?: string;
}

const { n, scheme, bleed = false, tipo = 'normal', bleedAlt = '' } = Astro.props;

if (!Number.isInteger(n) || n < 1 || n > 16) {
  throw new Error(`<Pliego n={${n}}>: n tiene que ser un entero entre 1 y 16.`);
}

const hasContent = Astro.slots.has('default');
const bleedImage = typeof bleed === 'boolean' ? undefined : bleed;
const showNum = tipo !== 'portada' && tipo !== 'contraportada';
const LABELS: Record<PliegoTipo, string> = {
  portada: 'Portada',
  indice: 'Índice',
  normal: `Página ${n}`,
  relleno: `Página ${n}`,
  fin: 'Fin',
  contraportada: 'Contraportada',
};
---

<section
  id={`pagina-${n}`}
  data-pliego={n}
  data-tipo={tipo}
  class:list={[
    'pliego',
    `pliego--${tipo}`,
    scheme && `scheme-${scheme}`,
    { 'pliego--bleed': bleed !== false, 'pliego--empty': !hasContent },
  ]}
  aria-label={tipo === 'relleno' ? undefined : LABELS[tipo]}
  aria-hidden={tipo === 'relleno' ? 'true' : undefined}
>
  {bleedImage && (
    <OptimizedImage
      src={bleedImage}
      alt={bleedAlt}
      class="pliego__bg"
      widths={[480, 768, 1024, 1440]}
      sizes="(max-width: 900px) 100vw, 852px"
      loading={n === 1 ? 'eager' : 'lazy'}
      fetchpriority={n === 1 ? 'high' : undefined}
      decoding={n === 1 ? 'sync' : 'async'}
      context={`Pliego ${n}`}
    />
  )}

  <div class="pliego__in">
    {hasContent ? (
      <slot />
    ) : tipo === 'fin' ? (
      <div class="pliego__fin">
        <p class="pliego__fin-word">Fin</p>
        {/* TODO: texto de cierre del volumen (créditos, agradecimientos, próximo número). */}
        <p class="pliego__todo">TODO: texto de cierre del volumen</p>
      </div>
    ) : (
      <div class="pliego__relleno">
        {/* TODO: contenido pendiente para esta página del impreso. */}
        <p class="pliego__todo">TODO · página {n}</p>
        <p class="pliego__todo-sub">Contenido pendiente</p>
      </div>
    )}
  </div>

  {showNum && <span class="pliego__num" aria-hidden="true">{n}</span>}
</section>

<style>
  /* ── Pantalla: un tramo más del scroll, no una página ─────────────── */
  .pliego {
    position: relative;
    box-sizing: border-box;
    width: 100%;
    display: block;
    background: transparent;
    color: inherit;
    border: 0;
    overflow: visible;
  }
  .pliego__in {
    position: relative;
    z-index: 1;
  }
  .pliego--normal {
    margin: 0 0 2rem;
  }
  .pliego__bg {
    display: block;
    width: 100%;
    height: auto;
    max-width: none;
    margin: 0 0 1rem;
  }
  /* Los marcadores vacíos de <SectionTitle pageBreak> no se ven. Indice
     y Contraportada también usan .fz-page-num, pero no están vacíos. */
  .pliego :global(.fz-page-num:empty) {
    display: none;
  }

  /* Página en blanco del cuadernillo: en la web no existe. El id queda
     para que el índice pueda anclar, sin caja ni texto de "TODO". */
  .pliego--relleno {
    height: 0;
    margin: 0;
    padding: 0;
    overflow: hidden;
    visibility: hidden;
  }

  .pliego__fin {
    text-align: center;
    padding: 1.5rem 0 0.5rem;
  }
  .pliego__todo {
    font-family: var(--font-head);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.8rem;
    margin: 0;
    opacity: 0.7;
  }
  .pliego__todo-sub {
    font-size: 0.75rem;
    opacity: 0.6;
    margin: 0.6rem 0 0;
  }
  .pliego__fin-word {
    font-family: 'Anton', var(--font-head);
    font-size: clamp(3rem, 12vw, 6rem);
    text-transform: uppercase;
    line-height: 1;
    margin: 0 0 0.6rem;
    color: var(--accent);
    -webkit-text-stroke: 2px var(--ink);
  }
  /* El número de página es del impreso. */
  .pliego__num {
    display: none;
  }

  /* ── Print: cada pliego, una página de media carta ────────────────── */
  @media print {
    .pliego {
      display: flex;
      flex-direction: column;
      height: 7.7in;
      overflow: hidden;
      background: var(--paper);
      color: var(--ink);
      break-inside: avoid;
      margin: 0;
    }
    .pliego + .pliego {
      break-before: page;
    }
    .pliego__in {
      flex: 1;
      display: flex;
      flex-direction: column;
      padding: 0.35in 0.4in 0.45in;
    }
    .pliego__bg {
      position: absolute;
      inset: 0;
      z-index: 0;
      width: 100%;
      height: 100%;
      margin: 0;
      object-fit: cover;
    }
    .pliego--bleed .pliego__in {
      padding: 0;
    }
    .pliego__num {
      display: block;
      position: absolute;
      bottom: 0.35rem;
      left: 50%;
      transform: translateX(-50%);
      z-index: 2;
      font-family: var(--font-head);
      font-weight: 700;
      font-size: 0.7rem;
      opacity: 1;
    }
    .pliego--portada,
    .pliego--contraportada {
      background: var(--ink);
      color: var(--paper);
    }
    .pliego--portada .pliego__in,
    .pliego--contraportada .pliego__in {
      padding: 0;
    }
    /* En el papel la página es el marco: los componentes no duplican borde. */
    .pliego :global(.fz-portada),
    .pliego :global(.fz-contraportada) {
      flex: 1;
      margin: 0;
      border: 0;
      border-radius: 0;
      min-height: 0;
    }
    .pliego :global(.fz-indice) {
      margin: 0;
      border: 0;
      border-radius: 0;
      padding: 0.5rem 0;
    }
    .pliego--relleno {
      height: 7.7in;
      visibility: visible;
      overflow: hidden;
      display: flex;
      background-image: repeating-linear-gradient(
        -45deg,
        transparent 0 14px,
        color-mix(in srgb, var(--ink) 7%, transparent) 14px 28px
      );
    }
    .pliego__relleno,
    .pliego__fin {
      flex: 1;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      padding: 0;
    }
    .pliego__todo {
      border: 3px dashed var(--ink);
      padding: 0.5em 1em;
    }
  }
</style>
