---
// Tarjeta "Llévatelo: este volumen en PDF" (issues #9/#10). Va justo
// debajo de la portada del volumen: la pinta Pliego.astro cuando
// tipo="portada", así los volúmenes MDX y los compuestos desde yml la
// traen sin tocar su marcado. Dos botones grandes (leer / imprimir en
// casa), el resto de PDF como ligas chicas y los pasos para engrapar en
// un <details>. Los pesos salen de print/build/manifest.json; sin manifest
// (build local sin Typst) queda una línea "PDF no disponible en este
// build" y el sitio compila igual. Sin JavaScript.
import { impresoDe, mb } from '../../utils/impreso';

interface Props {
  slug: string;
}
const { slug } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const v = impresoDe(slug);
const href = (k: keyof NonNullable<typeof v>['pdfs']) => `${base}/fanzine/${slug}/${v!.pdfs[k].archivo}`;
const hojas = v ? (v.pdfs.cuadernillo.hojas ?? v.paginas / 4) : 0;
---

{v ? (
  <aside class="fz-lleva fz-no-print" aria-label="Descargar el volumen en PDF">
    <span class="fz-lleva__sticker" aria-hidden="true">Gratis</span>
    <div class="fz-lleva__txt">
      <p class="fz-lleva__kicker">Llévatelo</p>
      <p class="fz-lleva__h">Este volumen<br />en PDF</p>
      <p class="fz-lleva__p">Léelo en el celular o imprímelo y engrápalo: {v.paginas} páginas de media carta, {hojas} hojas carta.</p>
    </div>
    <div class="fz-lleva__btns">
      <a class="fz-lleva__btn fz-lleva__btn--leer" href={href('pantalla')} download>
        <b>Para leer</b><small>PDF pantalla · {mb(v.pdfs.pantalla.bytes)}</small>
      </a>
      <a class="fz-lleva__btn" href={href('cuadernillo')} download>
        <b>Para imprimir en casa</b><small>Cuadernillo carta, color · {mb(v.pdfs.cuadernillo.bytes)}</small>
      </a>
      <p class="fz-lleva__mas">
        También:
        <a href={href('cuadernilloXerox')} download>cuadernillo xerox ({mb(v.pdfs.cuadernilloXerox.bytes)})</a> ·
        <a href={href('xerox')} download>xerox página por página ({mb(v.pdfs.xerox.bytes)})</a> ·
        <a href={href('imprenta')} download>imprenta ({mb(v.pdfs.imprenta.bytes)})</a> ·
        <a href={href('comoImprimir')} download>cómo imprimir, 1 pág. ({mb(v.pdfs.comoImprimir.bytes)})</a>
      </p>
      <details class="fz-lleva__como">
        <summary>Cómo imprimir y engrapar</summary>
        <ol>
          <li><strong>Elegí la versión:</strong> cuadernillo <em>color</em> para imprimir, cuadernillo <em>xerox</em> para fotocopiar en blanco y negro.</li>
          <li><strong>Papel carta, horizontal, al 100 %</strong> (sin "ajustar a página"). Cada cara trae dos páginas de media carta.</li>
          <li><strong>Doble cara, voltear por el borde corto.</strong></li>
          <li><strong>{hojas} hojas:</strong> apilalas como salen, doblá la pila a la mitad con la portada afuera y poné <strong>dos grapas en el lomo</strong>.</li>
        </ol>
      </details>
    </div>
  </aside>
) : (
  <p class="fz-lleva__nada fz-no-print">PDF no disponible en este build</p>
)}

<style>
  .fz-lleva {
    position: relative;
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 1.25rem 2rem;
    align-items: start;
    text-align: left;
    margin: -0.5rem 0 2.5rem;
    padding: 1.4rem 1.6rem 1.5rem;
    background: var(--accent);
    color: var(--ink);
    border: var(--border-w) solid var(--ink);
    border-radius: var(--radius);
    box-shadow: 8px 8px 0 var(--ink);
  }
  .fz-lleva__sticker {
    position: absolute;
    top: -1.1rem;
    right: 1.2rem;
    transform: rotate(6deg);
    font-family: 'Anton', var(--font-head);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 1.1rem;
    line-height: 1;
    padding: 0.45em 0.8em;
    background: var(--paper);
    color: var(--ink);
    border: 3px solid var(--ink);
    border-radius: 999px;
  }
  .fz-lleva__kicker {
    margin: 0;
    font-family: var(--font-head);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-size: 0.75rem;
  }
  .fz-lleva__h {
    margin: 0.1rem 0 0.6rem;
    font-family: 'Anton', var(--font-head);
    text-transform: uppercase;
    font-size: clamp(2.4rem, 6vw, 3.6rem);
    line-height: 0.92;
    letter-spacing: 0.01em;
  }
  .fz-lleva__p {
    margin: 0;
    font-size: 0.85rem;
    line-height: 1.5;
    max-width: 28rem;
  }
  .fz-lleva__btns {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .fz-lleva__btn {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    text-decoration: none;
    color: var(--ink);
    background: var(--paper);
    border: 3px solid var(--ink);
    border-radius: 12px;
    padding: 0.7rem 1rem 0.75rem;
    box-shadow: 4px 4px 0 var(--ink);
    transition: transform 0.08s ease, box-shadow 0.08s ease;
  }
  .fz-lleva__btn:hover,
  .fz-lleva__btn:focus-visible {
    transform: translate(2px, 2px);
    box-shadow: 2px 2px 0 var(--ink);
  }
  .fz-lleva__btn--leer {
    background: var(--ink);
    color: var(--paper);
  }
  .fz-lleva__btn b {
    font-family: var(--font-head);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: 0.95rem;
  }
  .fz-lleva__btn small {
    font-size: 0.72rem;
    opacity: 0.85;
  }
  .fz-lleva__mas,
  .fz-lleva__como {
    margin: 0.2rem 0 0;
    font-size: 0.72rem;
    line-height: 1.7;
  }
  .fz-lleva__mas a {
    color: inherit;
    font-weight: 700;
    text-decoration-thickness: 2px;
    text-underline-offset: 2px;
  }
  .fz-lleva__como {
    margin-top: 0;
  }
  .fz-lleva__como summary {
    cursor: pointer;
    font-family: var(--font-head);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .fz-lleva__como ol {
    margin: 0.3rem 0 0;
    padding-left: 1.2rem;
    line-height: 1.5;
  }
  .fz-lleva__como li {
    margin-bottom: 0.25rem;
  }
  .fz-lleva__nada {
    margin: -1rem 0 2rem;
    font-size: 0.7rem;
    opacity: 0.7;
  }
  @media (max-width: 640px) {
    .fz-lleva {
      grid-template-columns: 1fr;
      gap: 1rem;
      padding: 1.3rem 1.1rem 1.3rem;
      box-shadow: 5px 5px 0 var(--ink);
    }
    .fz-lleva__sticker {
      font-size: 0.9rem;
      right: 0.9rem;
    }
  }
  @media print {
    .fz-lleva,
    .fz-lleva__nada {
      display: none;
    }
  }
</style>
