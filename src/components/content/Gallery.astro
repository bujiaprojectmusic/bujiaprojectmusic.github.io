---
// Galería de fotos en grilla, cada una con un tilt levemente distinto
// (efecto "fotos tiradas en la mesa"). Para mostrar varias fotos de un
// mismo momento sin escribir un <ImageFull> por cada una.
// Uso:
// <Gallery images={[
//   { src: '/img/proceso-1.jpg', alt: 'Cortando el cuerpo' },
//   { src: '/img/proceso-2.jpg', alt: 'Lijando', caption: 'Tres horas de lija' },
//   { src: '/img/proceso-3.jpg', alt: 'Pintado' },
// ]} />
// Las fotos van en src/assets/img/ y se optimizan al compilar (ver OptimizedImage).
import OptimizedImage from '../OptimizedImage.astro';
import type { ImageSource } from '../../utils/resolveImage';

interface GalleryImage {
  src: ImageSource;
  alt: string;
  caption?: string;
}
interface Props {
  images: GalleryImage[];
}
const { images } = Astro.props;
const tilts = [-3, 2, -1.5, 3, -2.5, 1.5];
---

<div class="gallery">
  {images.map((img, i) => (
    <figure class="gallery__item" style={`--tilt:${tilts[i % tilts.length]}deg`}>
      <OptimizedImage
        src={img.src}
        alt={img.alt}
        widths={[320, 480, 640, 960]}
        sizes="(max-width: 640px) 50vw, 220px"
        context="Gallery"
      />
      {img.caption && <figcaption>{img.caption}</figcaption>}
    </figure>
  ))}
</div>

<style>
  .gallery {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
    gap: 1.5rem 1.2rem;
    margin: 2rem 0;
    padding: 1rem 0;
  }
  .gallery__item {
    margin: 0;
    background: #fff;
    padding: 8px 8px 28px;
    box-shadow: 0 6px 14px rgba(0, 0, 0, 0.25);
    transform: rotate(var(--tilt));
    transition: transform 0.15s ease;
  }
  .gallery__item:hover {
    transform: rotate(0deg) scale(1.03);
  }
  .gallery__item img {
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: cover;
  }
  .gallery__item figcaption {
    font-family: var(--font-head);
    font-size: 0.7rem;
    text-align: center;
    padding-top: 0.5em;
    color: #333;
  }
</style>
