---
// Imagen grande a todo el ancho, tipo portada. Para fotos que merecen
// protagonismo (el resultado final de un proyecto, una foto de grupo, etc).
// Uso: <ImageFull src="/img/telecaster-final.jpg" alt="Telecaster terminada" caption="Terminada, mayo 2026" />
// La foto va en src/assets/img/ y se optimiza al compilar (ver OptimizedImage).
import OptimizedImage from '../OptimizedImage.astro';
import type { ImageSource } from '../../utils/resolveImage';

interface Props {
  src: ImageSource;
  alt: string;
  caption?: string;
  // priority: true = es la imagen más grande que se ve al entrar a la
  // página (la "LCP"): se carga eager + fetchpriority="high" en vez de
  // lazy. Ponerlo SOLO en la primera foto de la página.
  priority?: boolean;
}
const { src, alt, caption, priority = false } = Astro.props;
---

<figure class="img-full">
  <OptimizedImage
    src={src}
    alt={alt}
    widths={[480, 768, 1024, 1440, 1920]}
    sizes="(max-width: 1140px) calc(100vw - 48px), 1092px"
    loading={priority ? 'eager' : 'lazy'}
    fetchpriority={priority ? 'high' : undefined}
    decoding={priority ? 'sync' : 'async'}
    context="ImageFull"
  />
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .img-full {
    margin: 2rem 0;
  }
  .img-full img {
    width: 100%;
    border: var(--border-w) solid var(--ink);
    border-radius: var(--radius);
  }
  .img-full figcaption {
    font-family: var(--font-head);
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    text-align: center;
    opacity: 0.7;
    margin-top: 0.6rem;
  }
</style>
