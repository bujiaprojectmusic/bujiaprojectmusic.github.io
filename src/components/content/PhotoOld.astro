---
// Foto vieja: sepia, viñeta, esquinas de cinta y ligera inclinación —
// para fotos de archivo, del taller hace años, etc.
// Uso: <PhotoOld src="/img/taller-2019.jpg" alt="El taller en 2019" caption="El local, 2019" tilt={2} />
// La foto va en src/assets/img/ y se optimiza al compilar (ver OptimizedImage).
import OptimizedImage from '../OptimizedImage.astro';
import type { ImageSource } from '../../utils/resolveImage';

interface Props {
  src: ImageSource;
  alt: string;
  caption?: string;
  tilt?: number;
  // priority: true = es la imagen más grande que se ve al entrar a la
  // página (la "LCP"): se carga eager + fetchpriority="high" en vez de
  // lazy. Ponerlo SOLO en la primera foto de la página.
  priority?: boolean;
}
const { src, alt, caption, tilt = -2, priority = false } = Astro.props;
---

<figure class="photo-old" style={`--tilt:${tilt}deg`}>
  <span class="photo-old__tape photo-old__tape--l" aria-hidden="true" />
  <span class="photo-old__tape photo-old__tape--r" aria-hidden="true" />
  <span class="photo-old__frame">
    <OptimizedImage
      src={src}
      alt={alt}
      widths={[480, 768, 1024, 1440]}
      sizes="(max-width: 900px) calc(100vw - 68px), 832px"
      loading={priority ? 'eager' : 'lazy'}
      fetchpriority={priority ? 'high' : undefined}
      decoding={priority ? 'sync' : 'async'}
      context="PhotoOld"
    />
  </span>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .photo-old {
    display: table;
    /* Las cintas sobresalen 14 px por lado; se descuentan del ancho para
       que a todo el ancho (móvil) no provoquen scroll horizontal. */
    max-width: calc(100% - 28px);
    margin: 2rem auto;
    transform: rotate(var(--tilt));
  }
  .photo-old__frame {
    display: block;
    position: relative;
    padding: 10px;
    background: #efe4c8;
    box-shadow: 0 8px 16px rgba(0, 0, 0, 0.3);
  }
  .photo-old__frame img {
    display: block;
    filter: sepia(0.55) contrast(1.05) brightness(0.95);
  }
  .photo-old__frame::after {
    content: '';
    position: absolute;
    inset: 10px;
    box-shadow: inset 0 0 40px rgba(0, 0, 0, 0.45);
    pointer-events: none;
  }
  .photo-old__tape {
    position: absolute;
    width: 60px;
    height: 22px;
    background: rgba(255, 255, 255, 0.5);
    border: 1px solid rgba(0, 0, 0, 0.1);
    top: -10px;
    z-index: 2;
  }
  .photo-old__tape--l {
    left: -14px;
    transform: rotate(-35deg);
  }
  .photo-old__tape--r {
    right: -14px;
    transform: rotate(35deg);
  }
  .photo-old figcaption {
    font-family: var(--font-head);
    font-size: 0.8rem;
    text-align: center;
    padding-top: 0.6em;
    color: #443;
  }
</style>
