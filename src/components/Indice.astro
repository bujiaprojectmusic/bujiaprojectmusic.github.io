---
// Índice del volumen: reemplaza el snippet "fz-indice" de Ghost.
// Uso en MDX:
// <Indice items={[
//   { page: "03", title: "Editorial" },
//   { page: "05", title: "Taller: rebobinado de pastillas" },
//   { page: "12", title: "Playlist del mes" },
// ]} />
interface Item {
  page: string;
  title: string;
}
interface Props {
  items: Item[];
  // Si true (default), cada ítem es un enlace a #pagina-<page>, el id que
  // genera <Pliego n={page}>. Sin JavaScript.
  linkPages?: boolean;
}
const { items, linkPages = true } = Astro.props;
const anchor = (page: string) => `#pagina-${parseInt(page, 10)}`;
---

<section class="fz-indice fz-page-num">
  <h2 class="fz-indice__title">Índice</h2>
  <ol class="fz-indice__list">
    {items.map((item) =>
      linkPages && Number.isInteger(parseInt(item.page, 10)) ? (
        <li>
          <a href={anchor(item.page)} class="fz-indice__link">
            <span class="fz-indice__page">{item.page}</span>
            <span class="fz-indice__dots" aria-hidden="true"></span>
            <span class="fz-indice__item-title">{item.title}</span>
          </a>
        </li>
      ) : (
        <li>
          <span class="fz-indice__page">{item.page}</span>
          <span class="fz-indice__dots" aria-hidden="true"></span>
          <span class="fz-indice__item-title">{item.title}</span>
        </li>
      ),
    )}
  </ol>
</section>

<style>
  .fz-indice {
    border: var(--border-w) solid var(--ink);
    border-radius: var(--radius);
    padding: 2rem;
    margin: 2rem 0;
  }
  .fz-indice__title {
    font-family: var(--font-head);
    font-weight: 700;
    text-transform: uppercase;
    font-size: 1.6rem;
    margin: 0 0 1rem;
  }
  .fz-indice__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .fz-indice__list li,
  .fz-indice__link {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    font-family: var(--font-head);
    margin-bottom: 0.6rem;
  }
  .fz-indice__link {
    flex: 1;
    margin-bottom: 0;
    text-decoration: none;
    color: inherit;
  }
  .fz-indice__page {
    font-weight: 700;
    color: var(--accent);
    -webkit-text-stroke: 1px var(--ink);
  }
  .fz-indice__dots {
    flex: 1;
    border-bottom: 2px dotted var(--ink);
    height: 0.6em;
  }
</style>
