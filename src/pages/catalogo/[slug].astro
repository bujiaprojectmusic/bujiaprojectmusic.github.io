---
import { getCollection } from 'astro:content';
import TallerLayout from '../../layouts/TallerLayout.astro';
import TallerCover from '../../components/taller/TallerCover.astro';
import SidebarBox from '../../components/taller/SidebarBox.astro';
import RelatedItemRow from '../../components/taller/RelatedItemRow.astro';
import FollowUsCard from '../../components/taller/FollowUsCard.astro';
import PrevNextNav from '../../components/taller/PrevNextNav.astro';
import OptimizedImage from '../../components/OptimizedImage.astro';

export async function getStaticPaths() {
  const rawItems = await getCollection('catalog', ({ data }) => data.enabled);
  const items = rawItems.sort((a, b) => a.data.order - b.data.order);
  return items.map((item, index) => ({
    params: { slug: item.slug },
    props: {
      item,
      prevItem: items[index - 1] ?? null,
      nextItem: items[index + 1] ?? null,
      otherItems: items.filter((i) => i.slug !== item.slug).slice(0, 4),
    },
  }));
}

const { item, prevItem, nextItem, otherItems } = Astro.props;
const { Content } = await item.render();
const { name, price, currency, image, category, soldOut, excerpt } = item.data;

const categoryLabel = category === 'servicio' ? 'Servicio' : 'Producto';
const priceLabel = price != null ? `$${price.toLocaleString('es-MX')} ${currency}` : undefined;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const withBase = (href: string) => (/^https?:\/\//.test(href) ? href : `${base}${href}`);
---

<TallerLayout title={name} description={excerpt}>
  <div class="container-wide catalog-detail-grid">
    <TallerCover tag={categoryLabel} title={name} colorScheme="rosa">
      <article class="catalog-detail">
        <a href={withBase('/catalogo')} class="catalog-detail__back">← Volver al catálogo</a>

        {priceLabel && (
          <p class="catalog-detail__price">
            <span>{priceLabel}</span>
          </p>
        )}

        <div class="catalog-detail__layout">
          <div class="catalog-detail__img">
            {/* Foto del producto/servicio: imagen LCP de la página → eager + high. */}
            <OptimizedImage
              src={image}
              alt={name}
              class="catalog-detail__pic"
              widths={[480, 768, 1024, 1440]}
              sizes="(max-width: 720px) calc(100vw - 48px), (max-width: 1440px) 32vw, 480px"
              loading="eager"
              fetchpriority="high"
              decoding="sync"
            />
            {soldOut && <span class="catalog-detail__badge">Agotado</span>}
          </div>

          <div class="post-body catalog-detail__body">
            <Content />
          </div>
        </div>

        <PrevNextNav
          prevHref={prevItem ? withBase(`/catalogo/${prevItem.slug}`) : undefined}
          prevLabel={prevItem?.data.name}
          nextHref={nextItem ? withBase(`/catalogo/${nextItem.slug}`) : undefined}
          nextLabel={nextItem?.data.name}
        />
      </article>
    </TallerCover>

    <aside class="catalog-detail__sidebar">
      {otherItems.length > 0 && (
        <SidebarBox title="Más del catálogo">
          {otherItems.map((other) => (
            <RelatedItemRow
              href={withBase(`/catalogo/${other.slug}`)}
              image={other.data.image}
              title={other.data.name}
            />
          ))}
        </SidebarBox>
      )}
      <FollowUsCard />
    </aside>
  </div>

  <style>
    .catalog-detail-grid {
      display: grid;
      grid-template-columns: 1fr 300px;
      gap: 2rem;
      align-items: start;
    }
    .catalog-detail__back {
      display: inline-block;
      text-decoration: none;
      font-family: var(--font-head);
      font-weight: 700;
      font-size: 0.85rem;
      text-transform: uppercase;
      margin-bottom: 1.2rem;
    }
    .catalog-detail__price {
      margin: 0 0 1.5rem;
    }
    .catalog-detail__price span {
      display: inline-block;
      background: var(--accent);
      color: var(--ink);
      border: 3px solid var(--ink);
      box-shadow: 5px 5px 0 var(--ink);
      transform: rotate(-1deg);
      font-family: var(--font-head);
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.02em;
      font-size: clamp(1.3rem, 3vw, 1.8rem);
      padding: 0.35em 0.9em;
    }
    .catalog-detail__layout {
      overflow: hidden;
    }
    .catalog-detail__img {
      position: relative;
      float: left;
      width: 45%;
      aspect-ratio: 1 / 1;
      margin: 0 2rem 1rem 0;
      background-color: rgba(127, 127, 127, 0.15);
      border: var(--border-w) solid var(--ink);
      border-radius: var(--radius);
      overflow: hidden;
    }
    .catalog-detail__pic {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center;
    }
    .catalog-detail__badge {
      position: absolute;
      z-index: 1;
      top: 1rem;
      left: 1rem;
      background: var(--ink);
      color: var(--paper);
      font-family: var(--font-head);
      font-weight: 700;
      text-transform: uppercase;
      font-size: 0.75rem;
      padding: 0.3em 0.8em;
      border-radius: 999px;
    }
    .catalog-detail__sidebar {
      display: flex;
      flex-direction: column;
      gap: 1.5rem;
      margin-top: 2rem;
    }

    @media (max-width: 960px) {
      .catalog-detail-grid {
        grid-template-columns: 1fr;
      }
      .catalog-detail__sidebar {
        margin-top: 0;
      }
    }
    @media (max-width: 720px) {
      .catalog-detail__img {
        float: none;
        width: 100%;
        margin: 0 0 1.2rem;
      }
    }
  </style>
</TallerLayout>
