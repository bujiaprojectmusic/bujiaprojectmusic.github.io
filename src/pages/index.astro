---
import TallerLayout from '../layouts/TallerLayout.astro';
import HeroSlider from '../components/taller/HeroSlider.astro';
import AboutSection from '../components/taller/AboutSection.astro';
import GuitarsSection from '../components/taller/GuitarsSection.astro';
import CatalogSection from '../components/taller/CatalogSection.astro';
import JournalSection from '../components/taller/JournalSection.astro';
import { taller } from '../config/site';

// Mapa clave -> componente. El orden real en pantalla lo decide
// taller.homeSections (src/config/site.ts), no el orden de este objeto.
const HOME_SECTIONS = {
  hero: HeroSlider,
  about: AboutSection,
  guitars: GuitarsSection,
  catalog: CatalogSection,
  journal: JournalSection,
};
---

<TallerLayout>
  {
    taller.homeSections.map((key) => {
      const Section = HOME_SECTIONS[key];
      return Section ? <Section /> : null;
    })
  }
</TallerLayout>
