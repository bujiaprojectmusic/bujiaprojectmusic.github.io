---
// /fanzine/colabora/enviar (issue #12): cómo mandar una colaboración al
// fanzine por correo. Intro, "Cómo enviar", tabla de campos, plantilla
// para copiar, permisos de publicación (borrador) y el botón "Mandar mi
// colaboración" (mailto: armado en build desde src/config/colabora.ts, la
// misma constante que llena el <pre>). Único contacto publicado: el correo
// de site.ts. Interruptor `fanzine.colabora.publicada` (site.ts): en false,
// noindex, fuera del sitemap, sin enlaces y con aviso de borrador.
// JS: sólo el botón opcional "Copiar plantilla" (inline, < 1 KB); sin JS la
// plantilla se copia a mano del <pre>.
import FanzineLayout from '../../../layouts/FanzineLayout.astro';
import { fanzine } from '../../../config/site';
import { CORREO, ASUNTO, PLANTILLA, CAMPOS, PERMISOS, PERMISOS_INTRO, PERMISOS_CIERRE, mailtoColabora } from '../../../config/colabora';

const publicada = fanzine.colabora.publicada;
const mailto = mailtoColabora();
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<FanzineLayout
  title="Manda tu colaboración"
  description="Cómo mandar una colaboración a La Jirafa Elektrika: plantilla, campos y permisos de publicación."
  colorScheme="acido"
  noindex={!publicada}
>
  <a slot="jump" href="#plantilla">Plantilla</a>
  <a slot="jump" href="#permisos">Permisos</a>

  <div class="env">
    {!publicada && (
      <p class="env__borrador fz-no-print" role="note">
        <strong>Borrador – pendiente de revisión legal.</strong> Esta página todavía no está publicada ni enlazada: el texto de
        permisos está en revisión.
      </p>
    )}

    <header class="env__head">
      <p class="env__eyebrow">Colabora</p>
      <h1 class="env__title">Manda tu<br />colaboración</h1>
      <p class="env__sub">
        <strong>La Jirafa Elektrika</strong> es el fanzine digital e impreso de Bujía Project Music, en Texcoco, MX: un volumen al
        mes, de 16 páginas, en media carta. Se arma con lo que la gente manda. Si tienes algo que contar, lee el{' '}
        <a href={`${base}/fanzine/colabora#manifiesto`}>manifiesto</a> y el{' '}
        <a href={`${base}/fanzine/colabora#acuerdo`}>acuerdo de colaboración</a>, y mándalo por correo con la plantilla de abajo.
      </p>
      <p class="env__cta">
        <a class="env__btn" href={mailto}>Mandar mi colaboración</a>
        <span class="env__cta-nota">Abre tu correo con el asunto y la plantilla ya puestos.</span>
      </p>
    </header>

    <section class="env__sec" id="como" aria-labelledby="como-t">
      <h2 id="como-t" class="env__h2"><span>01</span> Cómo enviar</h2>
      <ul class="env__lista">
        <li>Por <strong>correo</strong> a <a href={`mailto:${CORREO}`} class="env__correo">{CORREO}</a>.</li>
        <li>Asunto: <code>{ASUNTO}</code>.</li>
        <li>Fotos <strong>adjuntas</strong> (máx. 25 MB en total) o un <strong>link</strong> (Drive, WeTransfer o similar) si pesan más.</li>
        <li>Fotos en <strong>tamaño original</strong>, sin filtros ni recortes.</li>
        <li>Texto en el cuerpo del correo o adjunto (<code>.docx</code> o Google Doc).</li>
      </ul>
    </section>

    <section class="env__sec" id="campos" aria-labelledby="campos-t">
      <h2 id="campos-t" class="env__h2"><span>02</span> Qué va en el correo</h2>
      <div class="env__tabla-wrap" tabindex="0" role="region" aria-label="Tabla de campos del correo">
        <table class="env__tabla">
          <thead>
            <tr>
              <th scope="col">Campo</th>
              <th scope="col">Qué es</th>
              <th scope="col">¿Se publica?</th>
            </tr>
          </thead>
          <tbody>
            {CAMPOS.map((c) => (
              <tr>
                <th scope="row">{c.campo}</th>
                <td>{c.que}</td>
                <td class:list={['env__pub', !c.publica && 'env__pub--no']}>{c.publica ? 'Sí' : 'No'}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="env__sec" id="plantilla" aria-labelledby="plantilla-t">
      <h2 id="plantilla-t" class="env__h2"><span>03</span> Plantilla</h2>
      <p class="env__p">Copia esto en el cuerpo del correo y llénalo (el botón de abajo ya la trae puesta).</p>
      <div class="env__pre-wrap">
        <pre class="env__pre" id="plantilla-texto" tabindex="0">{PLANTILLA}</pre>
        <button type="button" class="env__copiar" id="copiar-plantilla" hidden data-ok="Copiada">Copiar plantilla</button>
      </div>
    </section>

    <section class="env__sec env__sec--permisos" id="permisos" aria-labelledby="permisos-t">
      <h2 id="permisos-t" class="env__h2"><span>04</span> Permisos de publicación y consentimiento</h2>
      {!publicada && <p class="env__sello">Borrador – pendiente de revisión legal</p>}
      <p class="env__p">{PERMISOS_INTRO}</p>
      <ol class="env__permisos">
        {PERMISOS.map((p) => (
          <li>
            <strong>{p.titulo}</strong> {p.texto}
          </li>
        ))}
      </ol>
      <p class="env__p env__p--fuerte">{PERMISOS_CIERRE}</p>
      <p class="env__p env__p--chico">
        El documento completo de principios y acuerdo de colaboración está en{' '}
        <a href={`${base}/fanzine/colabora#acuerdo`}>/fanzine/colabora</a>.
      </p>
    </section>

    <p class="env__cta env__cta--final">
      <a class="env__btn" href={mailto}>Mandar mi colaboración</a>
    </p>
  </div>

  {/* Botón "Copiar plantilla": progresivo y < 1 KB. Sin JS no aparece y la
      plantilla se copia del <pre>. */}
  <script is:inline>
    (function () {
      var b = document.getElementById('copiar-plantilla');
      var p = document.getElementById('plantilla-texto');
      if (!b || !p || !navigator.clipboard) return;
      b.hidden = false;
      b.addEventListener('click', function () {
        navigator.clipboard.writeText(p.textContent).then(function () {
          var t = b.textContent;
          b.textContent = b.getAttribute('data-ok');
          setTimeout(function () { b.textContent = t; }, 1800);
        });
      });
    })();
  </script>
</FanzineLayout>

<style>
  .env {
    max-width: 900px;
    margin: 0 auto;
    padding: 1.5rem 1.25rem 3rem;
  }
  .env__borrador {
    margin: 0 0 1.5rem;
    padding: 0.7rem 1rem;
    background: var(--ink);
    color: var(--paper);
    border: 3px dashed var(--accent);
    font-family: var(--font-head);
    font-size: 0.8rem;
    line-height: 1.5;
  }
  .env__head {
    margin-bottom: 2rem;
  }
  .env__eyebrow {
    font-family: var(--font-head);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    font-size: 0.75rem;
    background: var(--accent);
    display: inline-block;
    padding: 0.25em 0.7em;
    margin: 0 0 0.8rem;
  }
  .env__title {
    font-family: 'Anton', var(--font-head);
    font-weight: 400;
    text-transform: uppercase;
    font-size: clamp(2.6rem, 9vw, 5rem);
    line-height: 0.92;
    margin: 0 0 1rem;
    text-wrap: balance;
  }
  .env__sub {
    max-width: 42rem;
    line-height: 1.55;
    margin: 0 0 1.4rem;
  }
  .env__sub a,
  .env__p a {
    color: inherit;
    font-weight: 700;
    text-decoration-thickness: 3px;
    text-decoration-color: var(--accent);
    text-underline-offset: 3px;
  }
  .env__cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.8rem 1.2rem;
    margin: 0;
  }
  .env__cta--final {
    margin-top: 2rem;
    justify-content: center;
  }
  .env__cta-nota {
    font-size: 0.78rem;
    opacity: 0.8;
  }
  .env__btn {
    display: inline-block;
    font-family: var(--font-head);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: 1rem;
    text-decoration: none;
    color: var(--paper);
    background: var(--ink);
    border: 3px solid var(--ink);
    border-radius: 12px;
    padding: 0.8em 1.3em;
    box-shadow: 5px 5px 0 var(--accent);
    transition: transform 0.08s ease, box-shadow 0.08s ease;
  }
  .env__btn:hover,
  .env__btn:focus-visible {
    transform: translate(2px, 2px);
    box-shadow: 3px 3px 0 var(--accent);
  }
  .env__sec {
    border: var(--border-w) solid var(--ink);
    border-radius: var(--radius);
    background: var(--paper);
    padding: 1.4rem 1.5rem 1.6rem;
    margin: 0 0 1.5rem;
    scroll-margin-top: 1rem;
  }
  .env__sec--permisos {
    box-shadow: 8px 8px 0 var(--accent);
  }
  .env__h2 {
    margin: 0 0 1rem;
    font-family: 'Anton', var(--font-head);
    font-weight: 400;
    text-transform: uppercase;
    font-size: clamp(1.5rem, 5vw, 2.2rem);
    line-height: 1;
    border-bottom: var(--border-w) solid var(--ink);
    padding-bottom: 0.5rem;
  }
  .env__h2 span {
    color: var(--accent);
    -webkit-text-stroke: 1.5px var(--ink);
    margin-right: 0.4rem;
  }
  .env__lista {
    margin: 0;
    padding-left: 1.2rem;
    line-height: 1.6;
  }
  .env__lista li {
    margin-bottom: 0.4rem;
  }
  .env__correo {
    color: inherit;
    font-weight: 700;
    word-break: break-all;
    text-decoration-thickness: 3px;
    text-decoration-color: var(--accent);
    text-underline-offset: 3px;
  }
  code {
    font-family: var(--font-body);
    background: rgba(0, 0, 0, 0.06);
    padding: 0.1em 0.35em;
    border-radius: 4px;
  }
  .env__tabla-wrap {
    overflow-x: auto;
  }
  .env__tabla {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.85rem;
    line-height: 1.45;
  }
  .env__tabla th,
  .env__tabla td {
    text-align: left;
    vertical-align: top;
    padding: 0.55rem 0.6rem;
    border-bottom: 2px solid var(--ink);
  }
  .env__tabla thead th {
    font-family: var(--font-head);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-size: 0.68rem;
    background: var(--accent);
    white-space: normal;
  }
  .env__tabla tbody th {
    font-family: var(--font-head);
    white-space: nowrap;
  }
  .env__pub {
    font-family: var(--font-head);
    font-weight: 700;
    white-space: nowrap;
  }
  .env__pub--no {
    background: var(--ink);
    color: var(--paper);
    text-align: center;
  }
  .env__p {
    margin: 0 0 1rem;
    line-height: 1.55;
  }
  .env__p--fuerte {
    font-family: var(--font-head);
    font-weight: 700;
  }
  .env__p--chico {
    font-size: 0.8rem;
    margin: 0;
  }
  .env__pre-wrap {
    position: relative;
  }
  .env__pre {
    margin: 0;
    padding: 1rem 1.1rem;
    background: var(--ink);
    color: var(--paper);
    border-radius: 12px;
    font-family: var(--font-body);
    font-size: 0.8rem;
    line-height: 1.55;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
  .env__copiar {
    position: absolute;
    top: 0.6rem;
    right: 0.6rem;
    font-family: var(--font-head);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-size: 0.68rem;
    color: var(--ink);
    background: var(--accent);
    border: 2px solid var(--ink);
    border-radius: 999px;
    padding: 0.4em 0.8em;
    cursor: pointer;
    box-shadow: 2px 2px 0 var(--paper);
  }
  .env__sello {
    display: inline-block;
    font-family: var(--font-head);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.72rem;
    border: 3px solid var(--ink);
    padding: 0.35em 0.8em;
    transform: rotate(-2deg);
    margin: 0 0 1rem;
  }
  .env__permisos {
    margin: 0 0 1rem;
    padding-left: 1.3rem;
    line-height: 1.55;
  }
  .env__permisos li {
    margin-bottom: 0.6rem;
  }
  @media (max-width: 480px) {
    .env {
      padding: 1rem 1rem 3rem;
    }
    .env__sec {
      padding: 1.1rem 1rem 1.3rem;
      box-shadow: none;
    }
    .env__sec--permisos {
      box-shadow: 5px 5px 0 var(--accent);
    }
    .env__tabla tbody th {
      white-space: normal;
    }
  }
</style>
