---
// Portada del fanzine (issue #40): presentación editable
// (src/content/pages/fanzine-indice.mdx) y los volúmenes como puesto de
// revistas (PuestoRevistas), del más reciente al más antiguo. Si hubiera
// otros posts de la colección `posts` que no son volúmenes, van al final
// (viven en /blog/<slug>).
import { getCollection, getEntry } from 'astro:content';
import FanzineLayout from '../../layouts/FanzineLayout.astro';
import PuestoRevistas from '../../components/PuestoRevistas.astro';
import { listarVolumenesPublicos } from '../../utils/volumenes';
import { fanzine } from '../../config/site';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const pagina = await getEntry('pages', 'fanzine-indice');
if (!pagina) throw new Error('Falta src/content/pages/fanzine-indice.mdx (texto de /fanzine, issue #40).');
const { Content } = await pagina.render();
const vacio = pagina.data.vacio ?? {
  titulo: 'El primer número viene en camino',
  texto: 'Todavía no hay volúmenes publicados.',
  enlace: 'Colabora con el fanzine →',
};
// Volúmenes compuestos (src/content/volumenes/*.yml) y MDX (issue #13):
// los de prueba, sin_listar y en borrador no van en el archivo público.
// Más reciente primero: por número de volumen (el orden en que salen) y,
// si empatan, por fecha.
const volumes = (await listarVolumenesPublicos()).sort((a, b) => b.numero - a.numero || b.fecha.valueOf() - a.fecha.valueOf());
const allPosts = await getCollection('posts', ({ data }) => !data.draft && !data.prueba);
const others = allPosts
  .filter((p) => !p.data.fanzine)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<FanzineLayout title="Fanzine" description={pagina.data.description}>
  <div class="fz-index">
    <header class="fz-index__head">
      {pagina.data.tag && <p class="fz-index__eyebrow">{pagina.data.tag}</p>}
      <h1 class="fz-index__title">{pagina.data.title}</h1>
      {pagina.data.subtitle && <p class="fz-index__lema">{pagina.data.subtitle}</p>}
      <div class="fz-index__intro">
        <Content />
        {/* Enlace directo al formulario de envío (issue #12) sólo cuando esté publicado. */}
        {fanzine.colabora.publicada && (
          <p><a href={`${base}${fanzine.colabora.ruta}`}>Manda tu pieza por correo →</a></p>
        )}
      </div>
    </header>

    <section class="fz-index__puesto" aria-labelledby="fz-puesto-titulo">
      <h2 id="fz-puesto-titulo" class="fz-index__rotulo">
        En el puesto{volumes.length > 0 && <span class="fz-index__cuenta"> · {volumes.length} {volumes.length === 1 ? 'número' : 'números'}</span>}
      </h2>
      <PuestoRevistas volumenes={volumes} vacio={vacio} colabora={`${base}/fanzine/colabora`} base={base} />
    </section>

    {others.length > 0 && (
      <section class="fz-index__others">
        <h2>Otros posts</h2>
        <ul>
          {others.map((post) => (
            <li><a href={`${base}/blog/${post.slug}`}>{post.data.title}</a></li>
          ))}
        </ul>
      </section>
    )}
  </div>

  <style>
    .fz-index {
      max-width: 980px;
      margin: 0 auto;
      padding: 2rem 1rem 3rem;
    }
    .fz-index__head {
      max-width: 680px;
      margin-bottom: 2.25rem;
    }
    .fz-index__eyebrow {
      font-family: var(--font-head);
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.15em;
      font-size: 0.75rem;
      background: #ff2f92;
      color: #111;
      display: inline-block;
      padding: 0.25em 0.7em;
      margin: 0 0 0.6rem;
      transform: rotate(-2deg);
    }
    .fz-index__title {
      font-family: 'Anton', var(--font-head);
      font-weight: 400;
      text-transform: uppercase;
      font-size: clamp(2.4rem, 8vw, 4.5rem);
      line-height: 0.95;
      margin: 0 0 0.4rem;
    }
    .fz-index__lema {
      display: inline-block;
      font-family: var(--font-head);
      font-weight: 700;
      text-transform: uppercase;
      font-size: 0.8rem;
      letter-spacing: 0.05em;
      background: #ffe600;
      color: #111;
      padding: 0.2em 0.6em;
      margin: 0 0 1.1rem;
    }
    .fz-index__intro :global(p) {
      margin: 0 0 0.85rem;
      line-height: 1.6;
    }
    .fz-index__intro :global(a) {
      color: inherit;
      font-weight: 700;
      text-decoration-color: #ff2f92;
      text-decoration-thickness: 3px;
      text-underline-offset: 3px;
    }
    /* Pegboard del taller detrás de la repisa. */
    .fz-index__puesto {
      margin: 0 -1rem;
      padding: 1.5rem 1rem 2.5rem;
      background-color: #ece7da;
      background-image: radial-gradient(circle, rgb(0 0 0 / 0.18) 1.6px, transparent 2.2px);
      background-size: 18px 18px;
      border-top: 3px solid var(--ink);
      border-bottom: 3px solid var(--ink);
      /* Las copias encimadas y los stickers asoman: se recortan acá y no
         generan scroll horizontal en móvil. */
      overflow-x: clip;
    }
    .fz-index__rotulo {
      display: inline-block;
      font-family: var(--font-head);
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.12em;
      font-size: 0.8rem;
      background: #111;
      color: #fff;
      padding: 0.3em 0.75em;
      margin: 0;
      transform: rotate(-1.5deg);
    }
    .fz-index__cuenta {
      color: #ffe600;
    }
    .fz-index__others {
      margin-top: 3rem;
    }
    .fz-index__others h2 {
      font-family: var(--font-head);
      text-transform: uppercase;
      font-size: 1rem;
    }
    @media (min-width: 900px) {
      .fz-index__puesto {
        margin: 0;
        padding: 1.75rem 1.75rem 3rem;
        border: 3px solid var(--ink);
      }
    }
  </style>
</FanzineLayout>
