---
import FanzineLayout from '../layouts/FanzineLayout.astro';
import { listarVolumenes } from '../utils/volumenes';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
// Volúmenes yml y MDX (issue #13), sin los de prueba.
const volumes = (await listarVolumenes()).filter((v) => !v.prueba);
---

<FanzineLayout title="Volúmenes" description="Todos los volúmenes de La Jirafa Elektrika.">
  <div class="fz-vols">
    <h1>Volúmenes</h1>
    <ul class="vol-list">
      {volumes.map((v) => (
        <li>
          <a href={`${base}/fanzine/${v.slug}`}>
            <span class="vol-list__n">Vol. {v.numero}</span>
            <span>{v.titulo}</span>
          </a>
        </li>
      ))}
    </ul>
  </div>

  <style>
    .fz-vols {
      max-width: 900px;
      margin: 0 auto;
      padding: 2rem 1rem 3rem;
    }
    .fz-vols h1 {
      font-family: 'Anton', var(--font-head);
      font-weight: 400;
      text-transform: uppercase;
      font-size: clamp(2rem, 6vw, 3.5rem);
      margin: 0 0 1.5rem;
    }
    .vol-list {
      list-style: none;
      margin: 0;
      padding: 0;
      display: grid;
      gap: 0.8rem;
    }
    .vol-list a {
      display: flex;
      align-items: center;
      gap: 1rem;
      text-decoration: none;
      color: var(--ink);
      background: #fff;
      border: var(--border-w) solid var(--ink);
      border-radius: var(--radius);
      padding: 1rem 1.25rem;
      font-family: var(--font-head);
      font-weight: 700;
      text-transform: uppercase;
    }
    .vol-list__n {
      background: var(--accent);
      padding: 0.15em 0.6em;
      font-size: 0.8rem;
    }
  </style>
</FanzineLayout>
