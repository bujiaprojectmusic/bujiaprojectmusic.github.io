---
import { getCollection } from 'astro:content';
import FanzineLayout from '../layouts/FanzineLayout.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const posts = await getCollection('posts', ({ data }) => data.fanzine && !data.draft);
const volumes = posts.sort((a, b) => (b.data.volume ?? 0) - (a.data.volume ?? 0));
---

<FanzineLayout title="Volúmenes" description="Todos los volúmenes de La Jirafa Eléctrica.">
  <div class="fz-vols">
    <h1>Volúmenes</h1>
    <ul class="vol-list">
      {volumes.map((v) => (
        <li>
          <a href={`${base}/fanzine/${v.slug}`}>
            <span class="vol-list__n">Vol. {v.data.volume}</span>
            <span>{v.data.title}</span>
          </a>
        </li>
      ))}
    </ul>
  </div>

  <style>
    .fz-vols {
      max-width: 900px;
      margin: 0 auto;
      padding: 2rem 1rem 3rem;
    }
    .fz-vols h1 {
      font-family: 'Anton', var(--font-head);
      font-weight: 400;
      text-transform: uppercase;
      font-size: clamp(2rem, 6vw, 3.5rem);
      margin: 0 0 1.5rem;
    }
    .vol-list {
      list-style: none;
      margin: 0;
      padding: 0;
      display: grid;
      gap: 0.8rem;
    }
    .vol-list a {
      display: flex;
      align-items: center;
      gap: 1rem;
      text-decoration: none;
      color: var(--ink);
      background: #fff;
      border: var(--border-w) solid var(--ink);
      border-radius: var(--radius);
      padding: 1rem 1.25rem;
      font-family: var(--font-head);
      font-weight: 700;
      text-transform: uppercase;
    }
    .vol-list__n {
      background: var(--accent);
      padding: 0.15em 0.6em;
      font-size: 0.8rem;
    }
  </style>
</FanzineLayout>
