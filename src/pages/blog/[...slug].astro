---
import { getCollection } from 'astro:content';
import PostLayout from '../../layouts/PostLayout.astro';
import { fanzinePath } from '../../utils/fanzine';

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;

// Los volúmenes del fanzine viven en /fanzine/vol-NN (ver
// src/pages/fanzine/[slug].astro y utils/fanzine.ts). La URL vieja
// /blog/<slug> sigue existiendo pero redirige: en build estático Astro
// genera un HTML con <meta http-equiv="refresh"> + <link rel="canonical">
// a la URL nueva. Nada del fanzine se sirve bajo /blog/.
if (post.data.fanzine) {
  return Astro.redirect(fanzinePath(post), 301);
}

const { Content } = await post.render();
---

<PostLayout
  title={post.data.title}
  description={post.data.description}
  date={post.data.date}
  volume={post.data.volume}
  fanzine={post.data.fanzine}
  colorScheme={post.data.colorScheme}
  tags={post.data.tags}
  cover={post.data.cover}
  coverAlt={post.data.coverAlt}
  author={post.data.author}
>
  <Content />
</PostLayout>
