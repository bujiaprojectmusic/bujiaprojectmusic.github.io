---
import { getCollection } from 'astro:content';
import PostLayout from '../../layouts/PostLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;

// Los volúmenes del fanzine viven en /fanzine/<slug> (ver
// src/pages/fanzine/[slug].astro). La URL vieja /blog/<slug> sigue
// existiendo pero redirige: en build estático Astro genera un HTML con
// <meta http-equiv="refresh"> + <link rel="canonical"> a la URL nueva.
if (post.data.fanzine) {
  return Astro.redirect(`${import.meta.env.BASE_URL.replace(/\/$/, '')}/fanzine/${post.slug}`, 301);
}

const { Content } = await post.render();
---

<PostLayout
  title={post.data.title}
  description={post.data.description}
  date={post.data.date}
  volume={post.data.volume}
  fanzine={post.data.fanzine}
  colorScheme={post.data.colorScheme}
  tags={post.data.tags}
  cover={post.data.cover}
  coverAlt={post.data.coverAlt}
  author={post.data.author}
>
  <Content />
</PostLayout>
